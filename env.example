# Google Sheets Web App URLs
# Copy this file to .env and fill in your actual Google Apps Script web app URLs
# See GOOGLE_SHEETS_SETUP.md for instructions on creating these URLs

# Contact form web app URL
REACT_APP_GOOGLE_SHEETS_CONTACT_FORM=https://script.google.com/macros/s/YOUR_CONTACT_FORM_SCRIPT_ID/exec

# Question/Phone number form web app URL
REACT_APP_GOOGLE_SHEETS_QUESTION_FORM=https://script.google.com/macros/s/YOUR_QUESTION_FORM_SCRIPT_ID/exec

# Job application form web app URL (handles both form data and file uploads)
REACT_APP_GOOGLE_SHEETS_JOB_APPLICATION=https://script.google.com/macros/s/YOUR_JOB_APPLICATION_SCRIPT_ID/exec

# Candidate registration form web app URL
REACT_APP_GOOGLE_SHEETS_REGISTRATION_FORM=https://script.google.com/macros/s/YOUR_REGISTRATION_FORM_SCRIPT_ID/exec

# Hall ticket lookup web app URL
REACT_APP_GOOGLE_SHEETS_HALL_TICKET_LOOKUP=https://script.google.com/macros/s/YOUR_HALL_TICKET_LOOKUP_SCRIPT_ID/exec

# Admin panel password (default: sparkids@admin)
REACT_APP_ADMIN_PASSWORD=sparkids@admin
